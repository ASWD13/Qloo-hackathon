# Server-only credentials. Never prefix these with NEXT_PUBLIC_.
QLOO_API_KEY=
# Use the official HTTPS host assigned to your Qloo credentials.
QLOO_API_BASE_URL=https://api.qloo.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Optional original artwork/textiles via free, quota-limited HF ZeroGPU Spaces.
# Missing token uses anonymous quota; an optional server-only token uses account quota.
# No paid Inference Providers, provider credits, local GPU or model downloads required.
HF_TOKEN=
HF_IMAGE_MODEL=black-forest-labs/FLUX.2-klein-4B
# Supported alternative: black-forest-labs/FLUX.1-schnell (less reliable file serving).
# Disable only image synthesis; every design still completes with curated textures.
HF_GENERATE_TEXTURES=true
# Explicit developer-only fixtures. Public examples work without this switch.
USE_MOCK_AI=false
